__pycache__/
*.pyc
.venv/
.coverage
.pytest_cache/
.env
generator_control.env
generator_control.log*
events.db*
# dev.sh launcher runtime state (never committed): the tracked pidfile + the server console log.
dev.pid
dev.log
ssl_cert.pem
ssl_key.pem
generator_control.original.py
CLAUDE.md
scratchpads/
# Self-updater runtime dirs (never committed): rollback backups + download staging.
backups/
.update_staging/

# tools/: ignore the whole directory by DEFAULT so local/dev-only tools (e.g. the gitignored
# PII/secret scanner, scratch scripts) never get committed to the PUBLIC repo, then WHITELIST
# exactly the tools we ship/commit. (Ignore the CONTENTS `tools/*`, not the dir, so the negations
# below can re-include specific files.)
/tools/*
!/tools/gen-manifest.py
!/tools/changelog.py
!/tools/gp-monitor.py
!/tools/gp-monitor.md
# dev.py is a LOCAL dev-only launcher (mock GPIO) -- committed to the repo for
# convenience but DELIBERATELY NOT in SHIPPED_FILES / manifest.json, so it can never
# be installed onto a Pi by the updater.
!/tools/dev.py
