# ============================================================================
# Generator Control Configuration
# ============================================================================
# Copy to generator_control.env and edit.
# Plaintext passwords (USER_ lines) are auto-hashed on first startup.

# --- GPIO ---
# RELAY_PIN=27

# --- Generator Start Sequence ---
# MAX_START_RETRIES=1
# BUTTON_PRESS_DURATION=0.25
# PRIME_DELAY=0.75
# RETRY_DELAY=5

# --- Web Server ---
# HOST=0.0.0.0
# PORT=9400

# --- SSL / HTTPS ---
# SSL_ENABLED=1
# SSL_CERT_MODE controls the certificate:
#   auto   = self-signed, auto-generated + auto-renewed on startup (default). The cert
#            includes SANs for the hostname/.local/localhost/127.0.0.1; add extras below.
#   manual = use your OWN cert/key (SSL_CERT_FILE/SSL_KEY_FILE). Never generated or
#            overwritten; the app refuses to start if they're missing.
# SSL_CERT_MODE=auto
# SSL_CERT_FILE=ssl_cert.pem       # relative to this dir, or an absolute path
# SSL_KEY_FILE=ssl_key.pem
# SSL_SAN=DNS:generatorpi.home,IP:192.168.1.50   # extra SANs for the self-signed cert
# SSL_CERT_DAYS=365
# SSL_RENEW_DAYS=30
# See the README "TLS / HTTPS certificate" + "Web Push" sections (a TRUSTED cert is
# required for push to work off-device).

# --- API authentication (machine callers, e.g. HomeAssistant) ---
# Key auth lets HomeAssistant call the API with ?key=<key> in the URL (or an
# X-API-Key header) instead of a username/password. The browser login still works.
# API_KEY_ENABLED=1        # 1 = accept API-key auth (default), 0 = disable it
#
# API_KEY is AUTO-GENERATED into this file on first startup (when enabled + empty).
# To rotate: clear the value below (leave "API_KEY=") or delete the line, then
# restart the service:  sudo systemctl restart generator_control
# A fresh key is generated + written here; update HomeAssistant's key to match.
API_KEY=

# --- Web Push notifications (optional) ---
# Needs the 'pywebpush' library (see the README "Web Push notifications" section).
# When push is available, a VAPID keypair is AUTO-GENERATED into this file on first
# startup. The private key is SECRET. To rotate: clear both values (or delete both
# lines) and restart -- a fresh pair is generated (clients re-subscribe automatically).
# VAPID_SUBJECT=mailto:admin@localhost   # 'sub' claim sent to push services
# VAPID_PUBLIC_KEY=      # auto-generated (base64url; the browser's applicationServerKey)
# VAPID_PRIVATE_KEY=     # auto-generated (SECRET)
# FUEL_MONITOR_SECONDS=60   # how often the low-fuel projection is re-checked for a push

# --- Rate Limiting (brute force protection) ---
# RATE_LIMIT_MAX_FAILURES=5
# RATE_LIMIT_LOCKOUT_SECONDS=300
# RATE_LIMIT_CLEANUP_SECONDS=600
# RATE_LIMIT_MAX_TRACKED_IPS=1000

# --- Logging ---
# LOG_FILE=generator_control.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=3
# LOG_LEVEL=INFO

# --- Event log / durable state (SQLite) ---
# EVENT_LOG_DB=events.db     # persistent event log + run-hours/fuel/subscription state
# EVENT_LOG_MAX=10000        # cap on stored events; oldest are evicted past this

# --- Users (USER_<username>=<password>) ---
# Plaintext passwords are hashed automatically on first run.
USER_chris=changeme
USER_alex=changeme
